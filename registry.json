{
  "$schema": "https://ui.shadcn.com/schema/registry.json",
  "name": "grana",
  "homepage": "https://github.com/gatteo/grana",
  "items": [
    {
      "name": "theme",
      "type": "registry:style",
      "title": "Grana theme",
      "description": "The Grana token layer: palette, semantic slots per surface, brand overrides, the Tailwind theme and base. Import styles/grana.css as the Tailwind entry; set data-brand and data-surface on <html>; copy public/fonts.",
      "dependencies": ["tw-animate-css", "class-variance-authority", "clsx", "tailwind-merge", "@base-ui/react", "lucide-react"],
      "files": [
        { "path": "registry/grana/styles/grana.css", "type": "registry:file", "target": "styles/grana.css" },
        { "path": "registry/grana/styles/fonts.css", "type": "registry:file", "target": "styles/fonts.css" }
      ]
    }
  ],
  "include": [
    "registry/groups/controls/registry.json",
    "registry/groups/fields/registry.json",
    "registry/groups/status/registry.json",
    "registry/groups/surfaces/registry.json",
    "registry/groups/patterns/registry.json"
  ]
}
